{
  "name": "@easyshop/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "اپلیکیشن iOS و Android فروشگاه EasyShop (Capacitor)",
  "scripts": {
    "sync": "cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:ios": "cap sync ios && cap build ios",
    "build:android": "cap sync android && cap build android",
    "run:android": "cap run android",
    "copy": "cap copy"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/network": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "7.5.22"
    }
  }
}
