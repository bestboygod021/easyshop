{
  "appId": "ir.easyshop.app",
  "appName": "EasyShop",
  "webDir": "../web/dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#080c1a",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#080c1a"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#080c1a",
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "hostname": "easyshop.local",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#080c1a",
      "showSpinner": true,
      "spinnerColor": "#6366f1",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#080c1a"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
