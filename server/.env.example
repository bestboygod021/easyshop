# ------------------------------------------------------------------
# نمونه‌ی تنظیمات EasyShop — این فایل را به .env کپی کنید
# ------------------------------------------------------------------

# --- سرور -----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- امنیت ----------------------------------------------------------------
JWT_SECRET=یک-رشته-تصادفی-حداقل-۳۲-کاراکتری-وارد-کنید
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DAYS=30

# مبدأهای مجاز مرورگر (با کاما جدا کنید). خالی بگذارید تا فقط same-origin،
# localhost، اپ‌های بومی (Capacitor/Electron) و پیش‌نمایش‌های ابری مجاز باشند.
# نمونه: TRUSTED_ORIGINS=https://shop.example.com,https://admin.example.com
TRUSTED_ORIGINS=
# CORS_ORIGINS معمولاً نیازی نیست؛ فقط اگر فرانت‌اند روی دامنه‌ی دیگری است تنظیم کنید.
# هرگز در تولید '*' نگذارید (هشدار در لاگ سرور ثبت می‌شود).
CORS_ORIGINS=
CORS_CREDENTIALS=0

# پشت پروکسی معکوس (Nginx/Cloudflare) مقدار ۱ بگذارید تا IP واقعی کاربر خوانده شود.
# توجه: با روشن‌بودن این گزینه، هدر X-Forwarded-For باید توسط پروکسی بازنویسی شود،
# وگرنه مهاجم می‌تواند با هدر جعلی محدودیت نرخ را دور بزند.
TRUST_PROXY=0

# --- سیاست امنیتی (پیش‌فرض‌ها امن هستند) ----------------------------------
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
BODY_LIMIT=2mb
MAX_STRING_LENGTH=20000
MAX_UPLOAD_BYTES=8388608
MAX_WALLET_TOPUP=50000000
MAX_WALLET_TOPUP_DAILY=100000000
ENFORCE_ORIGIN=1
ALLOW_PREVIEW_ORIGINS=1
# در محیط دمو، توکن بازیابی رمز در پاسخ برگردانده می‌شود تا جریان تست شود.
# در تولید باید ۰ بماند (پیش‌فرض در NODE_ENV=production برابر ۰ است).
EXPOSE_RESET_TOKEN=0
# سقف نرخ درخواست‌ها (تعداد در پنجره‌ی زمانی مربوطه)
RATE_GLOBAL=300
RATE_AUTH=20
RATE_AI=20
RATE_UPLOAD=30
RATE_WRITE=40
RATE_SEARCH=60
RATE_TRACK=20
RATE_CHAT=30

# --- داده -----------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
SEED_DEMO_DATA=1

# --- هوش مصنوعی (اختیاری: می‌توانید از پنل مدیریت هم وارد کنید) ------------
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4096
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=local
