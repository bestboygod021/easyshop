# ------------------------------------------------------------------
# نمونه‌ی تنظیمات EasyShop — این فایل را به .env کپی کنید
# ------------------------------------------------------------------

# --- سرور -----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_URL=https://shop.example.com

# --- امنیت ----------------------------------------------------------------
# Generate independently and keep stable: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DAYS=30
ALLOW_SELF_PROMOTION=0
# کلید امضای HMAC برای زنجیره‌ی tamper-evident لاگ ممیزی؛ rotation با نسخه‌ی جدید
AUDIT_LOG_HMAC_KEY_VERSION=v1
AUDIT_LOG_HMAC_KEY_V1=
# در production secretها را از Vault Agent/CSI یا KMS-backed secret mount به فایل‌های جداگانه بدهید.
# برنامه فایل‌های SECRETS_DIR را می‌خواند؛ SECRET_STORE_PROVIDER فقط برچسب preflight است و اتصال مستقیم نمی‌سازد.
# SECRETS_DIR=/run/secrets/easyshop
# SECRET_STORE_PROVIDER=vault-agent

# مبدأهای مجاز مرورگر (با کاما جدا کنید). خالی بگذارید تا فقط same-origin،
# localhost، اپ‌های بومی (Capacitor/Electron) و پیش‌نمایش‌های ابری مجاز باشند.
# نمونه: TRUSTED_ORIGINS=https://shop.example.com,https://admin.example.com
TRUSTED_ORIGINS=
# CORS_ORIGINS معمولاً نیازی نیست؛ فقط اگر فرانت‌اند روی دامنه‌ی دیگری است تنظیم کنید.
# هرگز در تولید '*' نگذارید؛ راه‌اندازی production در این حالت متوقف می‌شود.
CORS_ORIGINS=
CORS_CREDENTIALS=0

# پشت پروکسی معکوس (Nginx/Cloudflare) مقدار ۱ بگذارید تا IP واقعی کاربر خوانده شود.
# توجه: با روشن‌بودن این گزینه، هدر X-Forwarded-For باید توسط پروکسی بازنویسی شود،
# وگرنه مهاجم می‌تواند با هدر جعلی محدودیت نرخ را دور بزند.
TRUST_PROXY=0

# --- سیاست امنیتی (پیش‌فرض‌ها امن هستند) ----------------------------------
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
BODY_LIMIT=2mb
MAX_STRING_LENGTH=20000
MAX_UPLOAD_BYTES=8388608
MAX_WALLET_TOPUP=50000000
MAX_WALLET_TOPUP_DAILY=100000000
ENFORCE_ORIGIN=1
ALLOW_PREVIEW_ORIGINS=1
# در محیط دمو، توکن بازیابی رمز در پاسخ برگردانده می‌شود تا جریان تست شود.
# در تولید باید ۰ بماند (پیش‌فرض در NODE_ENV=production برابر ۰ است).
EXPOSE_RESET_TOKEN=0
# سقف نرخ درخواست‌ها (تعداد در پنجره‌ی زمانی مربوطه)
RATE_GLOBAL=300
RATE_AUTH=20
RATE_AI=20
RATE_UPLOAD=30
RATE_WRITE=40
RATE_SEARCH=60
RATE_TRACK=20
RATE_CHAT=30

# --- داده -----------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
# Async-repository migration pilot only. The existing API still uses synchronous SQLite helpers.
DATABASE_DRIVER=sqlite
DATABASE_REQUIRE_TLS=1
# Supply DATABASE_URL through SECRETS_DIR/Vault only after PostgreSQL staging is provisioned.
# DATABASE_URL=postgresql://<role>:<secret>@<staging-host>/<db>?sslmode=verify-full
SEED_DEMO_DATA=0
# Snapshotها را روی volume مستقل قرار دهید؛ برای تولید، رمزگذاری اجباری است.
BACKUP_DIR=/mnt/easyshop-backups
BACKUP_ENCRYPTION_ENABLED=1
BACKUP_ENCRYPTION_KEY=
# اجرای حذف زمان‌بندی‌شده پیش‌فرض خاموش است؛ بعد از تأیید retention-policy.yml روشن کنید.
DATA_RETENTION_ENABLED=0
DATA_RETENTION_INTERVAL_MS=86400000
RETENTION_LOGIN_ATTEMPTS_DAYS=90
RETENTION_SMS_OTPS_DAYS=30
RETENTION_REFRESH_TOKENS_DAYS=7
RETENTION_PAYMENT_CALLBACKS_DAYS=180
RETENTION_TELEMETRY_ERRORS_DAYS=30
RETENTION_AGGREGATED_ERRORS_DAYS=180
RETENTION_AI_LOGS_DAYS=90
RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_LOGIN_HISTORY_DAYS=180

# --- پرداخت ---------------------------------------------------------------
# درگاه mock فقط در development/test مجاز است. در production، provider و allowlist را صریح تنظیم کنید.
PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDERS=
PAYMENT_ALLOW_MOCK=0
PAYMENT_TIMEOUT_MS=15000
TOMAN_TO_RIAL=10
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
ZIBAL_MERCHANT_ID=
ZIBAL_SANDBOX=0
MRPARDAKHT_PIN=
MRPARDAKHT_SANDBOX=0
BANK_DIRECT_BANK=mellat
BANK_DIRECT_MELLAT_TERMINAL_ID=
BANK_DIRECT_MELLAT_USERNAME=
BANK_DIRECT_MELLAT_PASSWORD=
BANK_DIRECT_SANDBOX=0
# Optional sandbox hosts/URLs must be HTTPS and explicitly allowlisted.
# BANK_DIRECT_MELLAT_API_URL=https://sandbox.example.invalid/pgwchannel/services/pgw?wsdl
# BANK_DIRECT_MELLAT_START_URL=https://sandbox.example.invalid/pgwchannel/startpay.mellat
# BANK_DIRECT_API_ALLOWED_HOSTS=bpm.shaparak.ir,sandbox.example.invalid
# BANK_DIRECT_START_ALLOWED_HOSTS=bpm.shaparak.ir,sandbox.example.invalid

# --- Observability: OpenTelemetry, Prometheus و SLO ------------------------
# برای export به Collector، OTEL_ENABLED=1 و endpoint شبکه‌ی داخلی را تنظیم کنید.
# OTEL_ENABLED=1
OTEL_SERVICE_NAME=easyshop-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# در تولید یک token تصادفی بگذارید و همان را فقط در secret فایل Prometheus قرار دهید.
METRICS_BEARER_TOKEN=
SLO_WINDOW_MS=300000
SLO_EVALUATION_INTERVAL_MS=60000
SLO_ALERT_COOLDOWN_MS=900000
SLO_AVAILABILITY_TARGET=0.999
SLO_MIN_HTTP_REQUESTS=20
SLO_HTTP_P95_TARGET_MS=750
SLO_PAYMENT_SUCCESS_TARGET=0.98
SLO_MIN_PAYMENT_VERIFICATIONS=10
# اختیاری؛ HTTPS و مقصد تحت کنترل اپراتور.
# OPS_ALERT_WEBHOOK_URL=
# Snapshotها را روی volume مستقل از DATA_DIR ذخیره و بیرون از سرور replicate کنید.
# BACKUP_DIR=/mnt/easyshop-backups

# --- هوش مصنوعی ----------------------------------------------------------
# برای ذخیره‌ی کلیدهای پنل با AES-256-GCM؛ secretها را در Secret Manager/Vault نگه دارید.
# نسخه‌ی فعال در ciphertext ثبت می‌شود؛ هنگام rotation نسخه‌ی تازه بسازید و re-encrypt اجرا کنید.
AI_KEY_ENCRYPTION_KEY_VERSION=v1
AI_KEY_ENCRYPTION_KEY=
AI_KEY_ENCRYPTION_KEY_V1=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4096
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=local
