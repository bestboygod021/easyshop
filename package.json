{
  "name": "easyshop",
  "version": "1.0.0",
  "private": true,
  "description": "EasyShop — پلتفرم فروشگاهی چندسکویی (وب، iOS، اندروید، ویندوز) با بک‌اند کامل، پنل مدیریت، پشتیبانی زنده و موتور هوش مصنوعی چندمدلی",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "start": "npm --workspace server start",
    "build": "npm --workspace web run build",
    "lint": "eslint . --max-warnings=0",
    "seed": "npm --workspace server run seed",
    "test": "npm --workspace server run test",
    "preview": "npm run build && npm --workspace server start",
    "desktop:install": "cd desktop && npm ci",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:runtime": "cd desktop && npm run test:runtime",
    "desktop:pack": "npm run build && cd desktop && npm run pack",
    "desktop:build": "npm run build && cd desktop && npm run dist",
    "mobile:install": "cd mobile && npm install",
    "mobile:add:ios": "cd mobile && npx cap add ios",
    "mobile:add:android": "cd mobile && npx cap add android",
    "mobile:sync": "npm run build && cd mobile && npx cap sync",
    "test:security": "node --test server/test/security.test.js",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:install": "playwright install chromium",
    "db:backup": "node server/src/db/backup.js create",
    "db:backup:verify": "node server/src/db/backup.js verify",
    "db:backup:drill": "node server/src/db/backup.js drill",
    "db:backup:publish": "node tools/publish-backup-offsite.mjs",
    "db:postgres:prepare": "node tools/prepare-postgres-staging.mjs",
    "db:postgres:import": "node tools/sqlite-to-postgres-migrate.mjs",
    "test:postgres-staging": "node --test tools/prepare-postgres-staging.test.mjs",
    "test:postgres-import": "node --test tools/sqlite-to-postgres-migrate.test.mjs",
    "ops:preflight": "node tools/production-readiness-preflight.mjs",
    "test:ops-preflight": "node --test tools/production-readiness-preflight.test.mjs",
    "test:container-image": "node --test tools/container-image.test.mjs",
    "test:release-evidence": "node --test tools/create-release-evidence.test.mjs",
    "test:db-isolation": "node --test tools/db-test-isolation.test.mjs",
    "test:vault-contract": "node --test tools/vault-contract.test.mjs",
    "test:shadow-read": "node --test server/test/shadow-read.test.js",
    "db:retention:preview": "node server/src/services/data-retention.js preview",
    "db:retention:apply": "node server/src/services/data-retention.js apply",
    "ai-keys:rotate": "node server/src/services/ai/rotate-keys.js",
    "load:test": "node tools/load-test.mjs",
    "sbom": "mkdir -p artifacts && cyclonedx-npm --ignore-npm-errors --package-lock-only --output-reproducible --output-file artifacts/easyshop-workspaces.cdx.json",
    "sbom:desktop": "mkdir -p artifacts && cyclonedx-npm --ignore-npm-errors --package-lock-only --output-reproducible --output-file artifacts/easyshop-desktop.cdx.json desktop/package.json",
    "sbom:mobile": "mkdir -p artifacts && cyclonedx-npm --ignore-npm-errors --package-lock-only --output-reproducible --output-file artifacts/easyshop-mobile.cdx.json mobile/package.json",
    "test:mobile-tooling": "node tools/mobile-tooling-smoke.mjs",
    "supplychain:audit": "node tools/audit-lockfiles.mjs",
    "test:supply-chain": "node --test tools/verify-release-artifacts.test.mjs",
    "pentest": "node tools/pentest.mjs",
    "security": "npm run test:security && npm run pentest"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
